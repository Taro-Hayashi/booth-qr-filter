{
  "manifest_version": 3,
  "name": "BOOTH QRコード発行済みタブ",
  "version": "1.0.0",
  "description": "BOOTHの注文一覧に「QRコード発行済み」タブを追加し、発送コード発行済みの注文のみをフィルタリングします。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://manage.booth.pm/orders*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "booth-qr-filter@hayashi.github.private",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "109.0"
    }
  }
}
